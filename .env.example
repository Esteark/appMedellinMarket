# Plantilla de variables. `pnpm env:local` genera .env.local con los valores de Supabase local.
# .env.local nunca se sube. En producción: Vercel (web) y GitHub Actions secrets (corrida).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
CORRIDA_USER_AGENT=MercadoMedellinBot/1.0 (+uso familiar; contacto en README)
